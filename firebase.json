{
  "hosting": [
    {
      "site": "saasstreak",
      "public": "out",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "admin.html", "admin.txt", "admin/**"],
      "cleanUrls": true,
      "trailingSlash": false,
      "headers": [
        {
          "source": "**/*.@(js|css|svg|png|jpg|jpeg|woff|woff2)",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
          ]
        }
      ]
    },
